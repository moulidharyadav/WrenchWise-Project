# ==============================================================================
# HORIZON BANK: ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
ENV=development
DEBUG=true
PORT=8000

# Layer 2: Security & Authentication
SECRET_KEY=enterprise_super_secret_jwt_key_9921_banking_auth_token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Layer 6: Enterprise Database
# Default: SQLite async development fallback
DATABASE_URL=sqlite+aiosqlite:///./banking.db
# PostgreSQL Alternative (Docker):
# DATABASE_URL=postgresql+asyncpg://banking_admin:banking_secure_password_2026@localhost:5432/horizon_banking

# Event Streaming (Redis Streams / Local In-Memory Fallback)
USE_LOCAL_EVENT_BUS=true
REDIS_URL=redis://localhost:6379/0

# Layer 3: AI Gateway & Experimental Model Settings
DEFAULT_MODEL=gemini-2.5-pro-experimental
FALLBACK_MODEL=deterministic-banking-expert
ENABLE_LLM_API=false
LLM_API_KEY=

# Thresholds & Governance
TOKEN_BUDGET_DAILY=500000
HITL_AMOUNT_THRESHOLD=25000.0
FRAUD_CRITICAL_THRESHOLD=75.0
